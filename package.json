{
  "name": "dsh-rewind-pro",
  "version": "0.2.0",
  "description": "DeepSeek Harness conversation rewind, fully reversible: cancellable two-phase rewind (pending -> commit/cancel), undo any rewind with history jump, Claude-Code-style workspace file restore, capability probing with graceful degradation. Rewind that never traps you.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rewind",
    "undo",
    "rollback",
    "checkpoint",
    "history",
    "restore",
    "time-travel"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && tsc -p tsconfig.client-test.json",
    "test": "vitest run",
    "verify:host": "node scripts/verify-host.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:host && npm pack --dry-run",
    "check:version": "node scripts/check-dsh-version.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDMUC/dsh-rewind-pro.git"
  }
}
